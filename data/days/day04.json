{"ar":"هُمْ يِجْتَهْدُونْ","ten":"Hum yijtahdoon","tta":"ஹும் யிஜ்தஹிதூன்","en":"They are hardworking","tm":"அவர்கள் கடினமாக உழைக்கிறார்கள்","w":[["هُمْ","they"],["يِجْتَهْدُونْ","they work hard"]]},
{"ar":"هُمْ بَايْعِينْ","ten":"Hum bay'een","tta":"ஹும் பாயிஈன்","en":"They are sellers","tm":"அவர்கள் விற்பனையாளர்கள்","w":[["هُمْ","they"],["بَايْعِينْ","sellers (lesson: بَائِعُونْ)"]]},
{"ar":"هُمْ يِدْرِسُونْ","ten":"Hum yidrisoon","tta":"ஹும் யித்ருஸூன்","en":"They are studying","tm":"அவர்கள் படிக்கிறார்கள்","w":[["هُمْ","they"],["يِدْرِسُونْ","they study"]]},
{"ar":"هُمْ فَايْزِينْ","ten":"Hum fayzeen","tta":"ஹும் ஃபாய்ஜீன்","en":"They are winners","tm":"அவர்கள் வெற்றியாளர்கள்","w":[["هُمْ","they"],["فَايْزِينْ","winners (lesson: فَائِزُونْ)"]]}
]}
]},
