{"ar":"هُوَّ [r:الْحِينْ|الْآنْ] فِي دُبَيّْ","ten":"Huwa [r:al-heen|al-aan] fi Dubai","tta":"ஹுவ [r:அல் ஹீன்|அல் ஆன்] ஃபீ துபய்","en":"He is now in Dubai","tm":"அவன் இப்போது துபாயில் இருக்கிறான்","w":[["هُوَّ","he"],["[r:الْحِينْ]","now (Gulf)"],["[r:الْآنْ]","now (formal)"],["فِي","in"],["دُبَيّْ","Dubai"]]},
{"ar":"هُوَّ مِنْ بَاكِسْتَانْ","ten":"Huwa min Pakistan","tta":"ஹுவ மின் பாகிஸ்தான்","en":"He is from Pakistan","tm":"அவன் பாகிஸ்தானில் இருந்து வருகிறான்","w":[["هُوَّ","he"],["مِنْ","from"],["بَاكِسْتَانْ","Pakistan"]]},
{"ar":"هُوَّ مُعَلِّمْ","ten":"Huwa mu'allim","tta":"ஹுவ முஅல்லிம்","en":"He is a teacher","tm":"அவர் ஆசிரியர்","w":[["هُوَّ","he"],["مُعَلِّمْ","teacher (man)"]]},
{"ar":"هُوَّ مُحَاسِبْ [r:هِنِي|هِنَا]","ten":"Huwa muhasib [r:hini|hina]","tta":"ஹுவ முஹாஸிப் [r:ஹினி|ஹுனா]","en":"He is an accountant here","tm":"அவன் இங்கு கணக்காளராக இருக்கிறான்","w":[["هُوَّ","he"],["مُحَاسِبْ","accountant"],["[r:هِنِي]","here (Gulf)"],["[r:هِنَا]","here"]]},
{"ar":"هُوَّ يِشْتَغِلْ فِي شَرِكَة مُحَمَّدْ","ten":"Huwa yishtaghil fi sharikat Muhammad","tta":"ஹுவ யிஷ்தகில் ஃபீ ஷரிகத் முஹம்மது","en":"He works in Muhammad's company","tm":"அவன் முஹம்மதுடைய நிறுவனத்தில் வேலை செய்கிறான்","w":[["هُوَّ","he"],["يِشْتَغِلْ","he works"],["فِي","in"],["شَرِكَة","company (of)"],["مُحَمَّدْ","Muhammad"]]},
{"ar":"هُوَّ [r:سَاكِنْ|يِسْكِنْ] فِي شُقِّتِي","ten":"Huwa [r:sakin|yiskin] fi shuqqati","tta":"ஹுவ [r:ஸாகின்|யஸ்குன்] ஃபீ ஷுக்கதி","en":"He lives in my apartment","tm":"அவன் என் குடியிருப்பில் வசிக்கிறான்","w":[["هُوَّ","he"],["[r:سَاكِنْ]","living / residing"],["[r:يِسْكِنْ]","he lives"],["فِي","in"],["شُقِّتِي","my apartment"]]}
]},
{"title":"3. Hiya — She","ar":"هِيَّ","ta":"அவள்","note":{"en":"With هِيَّ, add ـة (-a) at the end of the noun / describing word.","ta":"நாம் (هي) பயன்படுத்தும் பொழுது பெயர்ச்சொல்லின் இறுதியில் (ة) சேர்க்க வேண்டும்."},"items":[
{"key":true,"ar":"هِيَّ مُدَرِّبَة","ten":"Hiya mudarriba","tta":"ஹிய முதர்ரிபா","en":"She is a trainer","tm":"அவள் பயிற்சியாளர்","w":[["هِيَّ","she"],["مُدَرِّبَة","trainer (woman)"]]},
{"ar":"هِيَّ طَبِيبَة","ten":"Hiya tabeeba","tta":"ஹிய தபீபா","en":"She is a doctor","tm":"அவள் மருத்துவர்","w":[["هِيَّ","she"],["طَبِيبَة","doctor (woman)"]]},
{"ar":"هِيَّ جَالْسَة","ten":"Hiya jalsa","tta":"ஹிய ஜாலிஸா","en":"She is sitting","tm":"அவள் உட்கார்ந்து இருக்கிறாள்","w":[["هِيَّ","she"],["جَالْسَة","sitting (woman)"]]},
{"ar":"هِيَّ [r:نَايْمَة|نَائِمَة]","ten":"Hiya [r:nayma|na'ima]","tta":"ஹிய [r:நாயிமா|நாஇமா]","en":"She is sleeping","tm":"அவள் தூங்குகிறாள்","w":[["هِيَّ","she"],["[r:نَايْمَة]","sleeping (spoken)"],["[r:نَائِمَة]","sleeping (formal)"]]},
{"ar":"هِيَّ مِنْ إِنْدُونِيسْيَا","ten":"Hiya min Indonesia","tta":"ஹிய மின் இந்தூநிஸியா","en":"She is from Indonesia","tm":"அவள் இந்தோனேஸியாவில் இருந்து வருகிறாள்","w":[["هِيَّ","she"],["مِنْ","from"],["إِنْدُونِيسْيَا","Indonesia"]]},
{"ar":"هِيَّ رَبَّة الْبَيْتْ","ten":"Hiya rabbat al bait","tta":"ஹிய ரப்பதுல் பைத்","en":"She is a housewife","tm":"அவள் குடும்பத்தலைவி","w":[["هِيَّ","she"],["رَبَّة","lady / mistress (of)"],["الْبَيْتْ","the house"]]},
{"ar":"هِيَّ مُمَرِّضَة","ten":"Hiya mumarridha","tta":"ஹிய முமர்ரிழா","en":"She is a nurse","tm":"அவள் செவிலியர்","w":[["هِيَّ","she"],["مُمَرِّضَة","nurse (woman)"]]},
{"ar":"هِيَّ مُحَاسْبَة","ten":"Hiya muhasba","tta":"ஹிய முஹாஸிபா","en":"She is an accountant","tm":"அவள் கணக்காளர்","w":[["هِيَّ","she"],["مُحَاسْبَة","accountant (woman)"]]},
{"ar":"هِيَّ مِتْزَوْجَة","ten":"Hiya mitzawja","tta":"ஹிய மித்ஜவ்விஜா","en":"She is married","tm":"அவள் திருமணமானவள்","w":[["هِيَّ","she"],["مِتْزَوْجَة","married (woman)"]]},
{"ar":"هِيَّ عَازْبَة","ten":"Hiya 'azba","tta":"ஹிய ஆஜிபா","en":"She is single","tm":"அவள் திருமணமாகாதவள்","w":[["هِيَّ","she"],["عَازْبَة","single (woman)"]]},
{"ar":"هِيَّ [r:فَاضْيَة|مِتْفَرْغَة]","ten":"Hiya [r:fadhya|mitfarrigha]","tta":"ஹிய [r:ஃபாழியா|முதஃபர்ரிகா]","en":"She is free","tm":"அவள் சும்மா இருக்கிறாள்","w":[["هِيَّ","she"],["[r:فَاضْيَة]","free / not busy (Gulf)"],["[r:مِتْفَرْغَة]","free / available"]]}
]},
{"title":"4. Ihna — We","ar":"[r:إِحْنَا|حِنَّا|نَحْنُ]","ta":"நாம்","note":{"en":"إِحْنَا / حِنَّا are spoken Gulf; نَحْنُ is formal. All mean “we”.","ta":"إِحْنَا / حِنَّا பேச்சு வழக்கு; نَحْنُ முறையானது."},"items":[
{"key":true,"ar":"[r:إِحْنَا|نَحْنُ] طُلَّابْ","ten":"[r:Ihna|Nahnu] tullab","tta":"[r:இஹ்னா|நஹ்னு] துல்லாப்","en":"We are students","tm":"நாங்கள் மாணவர்கள்","w":[["[r:إِحْنَا]","we (Gulf)"],["[r:نَحْنُ]","we (formal)"],["طُلَّابْ","students"]]},
{"ar":"إِحْنَا عُمَّالْ","ten":"Ihna 'ummal","tta":"இஹ்னா உம்மால்","en":"We are workers","tm":"நாங்கள் வேலைக்காரர்கள்","w":[["إِحْنَا","we"],["عُمَّالْ","workers"]]},
{"ar":"إِحْنَا رْيَايِيلْ","ten":"Ihna ryayeel","tta":"இஹ்னா ரயாயீல்","en":"We are men","tm":"நாங்கள் ஆண்கள்","w":[["إِحْنَا","we"],["رْيَايِيلْ","men (Emirati; formal رِجَالْ rijal)"]]},
{"ar":"إِحْنَا سَوَّاقِينْ","ten":"Ihna sawwaqeen","tta":"இஹ்னா ஸவ்வாகீன்","en":"We are drivers","tm":"நாங்கள் ஓட்டுநர்கள்","w":[["إِحْنَا","we"],["سَوَّاقِينْ","drivers (lesson: سَائِقِينْ saa'iqeen)"]]},
{"ar":"إِحْنَا سُيَّاحْ","ten":"Ihna suyyah","tta":"இஹ்னா சுய்யாஹ்","en":"We are tourists","tm":"நாங்கள் சுற்றுலா பயணிகள்","w":[["إِحْنَا","we"],["سُيَّاحْ","tourists"]]},
{"ar":"إِحْنَا أَطِبَّاءْ","ten":"Ihna atibba'","tta":"இஹ்னா அதிப்பா","en":"We are doctors","tm":"நாங்கள் மருத்துவர்கள்","w":[["إِحْنَا","we"],["أَطِبَّاءْ","doctors"]]},
{"ar":"إِحْنَا مُسْلِمِينْ","ten":"Ihna muslimeen","tta":"இஹ்னா முஸ்லிமீன்","en":"We are Muslims","tm":"நாங்கள் முஸ்லிம்கள்","w":[["إِحْنَا","we"],["مُسْلِمِينْ","Muslims"]]},
{"ar":"إِحْنَا هُنُودْ","ten":"Ihna hunood","tta":"இஹ்னா ஹுனூத்","en":"We are Indians","tm":"நாங்கள் இந்தியர்கள்","w":[["إِحْنَا","we"],["هُنُودْ","Indians"]]},
{"ar":"إِحْنَا زُوَّارْ مِنَ الْهِنْدْ","ten":"Ihna zuwwar minal Hind","tta":"இஹ்னா ஜுவ்வார் மினல் ஹிந்த்","en":"We are visitors from India","tm":"நாங்கள் இந்தியாவில் இருந்து வந்த பார்வையாளர்கள்","w":[["إِحْنَا","we"],["زُوَّارْ","visitors"],["مِنَ","from"],["الْهِنْدْ","India"]]},
