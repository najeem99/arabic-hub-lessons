{"tag":"Woman","ar":"أَنَا طَالْبَة","ten":"Ana taliba","tta":"அன தாலிபா","en":"I'm a student (woman)","tm":"நான் மாணவி","w":[["أَنَا","I"],["طَالْبَة","student (woman)"]]},
{"ar":"أَنَا مُهَنْدِسْ","ten":"Ana muhandis","tta":"அன முஹந்திஸ்","en":"I'm an engineer","tm":"நான் பொறியாளன்","w":[["أَنَا","I"],["مُهَنْدِسْ","engineer"]]},
{"tag":"Woman","ar":"أَنَا مُعَلِّمَة","ten":"Ana mu'allima","tta":"அன முஅல்லிமா","en":"I'm a teacher (woman)","tm":"நான் ஆசிரியை","w":[["أَنَا","I"],["مُعَلِّمَة","teacher (woman)"]]},
{"ar":"أَنَا بَايِعْ","ten":"Ana baayi'","tta":"அன பாயிஃ","en":"I'm a seller","tm":"நான் விற்பனையாளன்","w":[["أَنَا","I"],["بَايِعْ","seller"]]},
{"tag":"Woman","ar":"أَنَا صَايْمَة","ten":"Ana sayma","tta":"அன ஸாயிமா","en":"I'm fasting (woman)","tm":"நான் நோன்பாளி","w":[["أَنَا","I"],["صَايْمَة","fasting (woman; man: صَايِمْ)"]]},
{"ar":"أَنَا عَالِمْ","ten":"Ana 'aalim","tta":"அன ஆலிம்","en":"I'm a scholar","tm":"நான் கல்வியாளன்","w":[["أَنَا","I"],["عَالِمْ","scholar"]]},
{"ar":"أَنَا مِنْ دُبَيّْ","ten":"Ana min Dubai","tta":"அன மின் துபாய்","en":"I'm from Dubai","tm":"நான் துபாயில் இருந்து வருகிறன்","w":[["أَنَا","I"],["مِنْ","from"],["دُبَيّْ","Dubai"]]},
{"ar":"أَنَا مِتْزَوِّجْ","ten":"Ana mitzawwij","tta":"அன மித்ஜவ்விஜ்","en":"I'm married","tm":"நான் திருமணமானவன்","w":[["أَنَا","I"],["مِتْزَوِّجْ","married (man)"]]},
{"ar":"أَنَا [r:مُبْ|مُو|مَانِي] طَبَّاخْ","ten":"Ana [r:mub|mu|maani] tabbakh","tta":"அன [r:முப்|மூ|மானீ] தப்பாஹ்","en":"I'm not a chef","tm":"நான் சமயல்காரன் அல்ல","w":[["أَنَا","I"],["[r:مُبْ]","not (UAE)"],["[r:مُو]","not"],["[r:مَانِي]","I am not"],["طَبَّاخْ","cook / chef"]]},
{"ar":"أَنَا تْخَرَّجْتْ","ten":"Ana tkharrajt","tta":"அன தஹர்ரஜ்த்","en":"I graduated","tm":"நான் பட்டம்பெற்றேன்","w":[["أَنَا","I"],["تْخَرَّجْتْ","I graduated"]]},
{"ar":"أَنَا [r:مُبْ|مُو|مَانِي] سَايِقْ سَيَّارَة","ten":"Ana [r:mub|mu|maani] saayiq sayyara","tta":"அன [r:முப்|மூ|மானீ] ஸாயிக் ஸய்யாரா","en":"I'm not a car driver","tm":"நான் கார் ஓட்டுநர் அல்ல","w":[["أَنَا","I"],["[r:مُبْ]","not (UAE)"],["[r:مُو]","not"],["[r:مَانِي]","I am not"],["سَايِقْ","driver"],["سَيَّارَة","car"]]}
]},
{"title":"2. Huwa — He","ar":"هُوَّ","ta":"அவன்","items":[
{"key":true,"ar":"هُوَّ وِلْدِي","ten":"Huwa wildi","tta":"ஹுவ வில்தீ","en":"He is my son","tm":"அவன் என் பையன்","w":[["هُوَّ","he"],["وِلْدِي","my son (Gulf; lesson: إِبْنِي ibni)"]]},
{"ar":"هُوَّ مُدِيرْ","ten":"Huwa mudeer","tta":"ஹுவ முதீர்","en":"He is a manager","tm":"அவன் மேலாளர்","w":[["هُوَّ","he"],["مُدِيرْ","manager"]]},
